<%- include("../partials/header") %>

<link rel="stylesheet" href="/react/main.css">

<section class="container">

  <h1><%= book.title %></h1>
  <p>Author: <%= book.author %></p>

  <h2>Your Notes</h2>
  <p><%= book.notes %></p>

  <% if (!book.ai_summary) { %>
    <form action="/books/<%= book.id %>/generate" method="POST">
      <button type="submit" class="btn">Generate Insights</button>
    </form>
  <% } %>

  <% if (book.ai_summary) { %>
    <h2>AI Summary</h2>
    <p><%= book.ai_summary %></p>

    <h2>30-Day Action Plan</h2>
    <p><%= book.action_plan %></p>

    <!-- React mounts here -->
    <div id="habit-tracker-root" data-book-id="<%= book.id %>"></div>

    <!-- Load React AFTER the div exists -->
    <script type="module" src="/react/main.js"></script>
  <% } %>

  <form action="/books/<%= book.id %>/delete" method="POST">
    <button type="submit" class="btn btn-danger">Delete Book</button>
  </form>

  <a href="/dashboard" class="btn">Back to Dashboard</a>

</section>

<%- include("../partials/footer") %>