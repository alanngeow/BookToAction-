<%- include("../partials/header") %>

<!-- Load compiled React CSS -->
<link rel="stylesheet" href="/react/main.css">
<script type="module" src="/react/main.js"></script>

<section class="container">

  <h1><%= book.title %></h1>
  <p>Author: <%= book.author %></p>

  <h2>Your Notes</h2>
  <p><%= book.notes %></p>

  <!-- Only show button if AI insights don't exist yet -->
  <% if (!book.ai_summary) { %>
    <form action="/books/<%= book.id %>/generate" method="POST">
      <button type="submit" class="btn">Generate Insights</button>
    </form>
  <% } %>

  <!-- Only show insights if they exist -->
  <% if (book.ai_summary) { %>
    <h2>AI Summary</h2>
    <p><%= book.ai_summary %></p>

    <h2>30-Day Action Plan</h2>
    <p><%= book.action_plan %></p>

        <!-- 
      React mounts here.
      This div is where the HabitTracker component will appear.
    -->
    <div id="habit-tracker-root"></div>


<script>
  window.__ACTION_PLAN__ = "<%= encodeURIComponent(book.action_plan) %>";
</script>

    <!-- Load the compiled React component -->
<script type="module" src="/react/assets/main-Bq1pW3Mf.js"></script>
  <% } %>



  <a href="/dashboard" class="btn">Back to Dashboard</a>

</section>

<%- include("../partials/footer") %>