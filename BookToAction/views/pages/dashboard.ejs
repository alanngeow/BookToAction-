<%- include("../partials/header") %>

<!--
================================================
Dashboard Page

Purpose:
Displays all books added by the user.
Books are retrieved from PostgreSQL via
the getDashboard controller.
================================================
-->

<section class="container">

  <h1>Your Books</h1>

  <a href="/add-book" class="btn">Add New Book</a>

  <div class="book-list">

    <!-- Check if there are any books -->
    <% if (books.length === 0) { %>
      <p>No books yet. Add your first book!</p>

    <% } else { %>

      <!-- Loop through each book from the database -->
      <% books.forEach(book => { %>

        <div class="book-card">
          <h3> <%= book.title %> </h3>
          <p>Author: <%= book.author %></p>
          <a href="/books/<%= book.id%>">View Details</a>
        </div>

      <% }); %>

    <% } %>

  </div>

</section>

<%- include("../partials/footer") %>